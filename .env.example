# StockPulse Portfolio Management System Configuration
# Copy this file to .env and customize with your credentials

# Flask Application Settings
SECRET_KEY=production_secret_key_change_in_production
FLASK_ENV=production
PORT=5000

# MySQL 8.0+ Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=portfolio_db

# When deploying on Railway / Render:
# MYSQL_URL or individual host/port/user/pass variables provided by the platform
